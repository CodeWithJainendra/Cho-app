# Auth v2 - Session-based encrypted login
SESSION_AUTH_ENDPOINT=/auth_v2/api/session/authenticate
LOGIN_ENDPOINT=/master/api/chos/login
CHECK_SESSION_ENDPOINT=/master/api/chos/check-session

# Appointments
APPOINTMENTS_BY_CHO_ENDPOINT=/appointment/api/appointments/cho/
CHO_APPOINTMENTS_ENDPOINT=/appointment/api/appointments/cho-appointments

# Booking
BOOKING_URL=https://dhanvantari.net.in/pres/booking

# ----- SAMAR (Auth for Face Auth Token) -----
SAMAR_BASE_URL=https://samar.iitk.ac.in/hs
SAMAR_AUTH_SESSION_ENDPOINT=/auth_v2/api/session/authenticate
SAMAR_CLIENT_ID=test_client_m9v10qhs
SAMAR_CLIENT_SECRET=test_secret

# ----- CDIS StampJar (Face Auth APIs) -----
STAMPJAR_BASE_URL=https://cdis.stampjar.com
STAMPJAR_FACE_TXNID_ENDPOINT=/patientv2/api/patient-auth/face/txnid
STAMPJAR_FACE_ENROLL_ENDPOINT=/patientv2/api/patient-auth/face/enroll

# ----- PHR Sandbox (Face Auth URL) -----
PHR_SBX_BASE_URL=https://phrsbx.abdm.gov.in
